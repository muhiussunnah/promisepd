# ─────────────────────────────────────────────────────────────
# Supabase — backs the contact form + newsletter sign-ups.
# Get these values from the Supabase dashboard:
#   Project Settings → API
# ─────────────────────────────────────────────────────────────

# Project URL — looks like https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon (public) key — safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-only.  Bypasses RLS.  Never commit, never
# expose to the browser, never inline into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Optional — override the canonical site URL used by metadata,
# sitemap, JSON-LD and OG tags.  Defaults to the Vercel-provided
# URL in production and https://promisepd.com as a final fallback.
# ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://promisepd.com
